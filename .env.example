# 与 zak 共用同一 PostgreSQL（先在 zak 侧执行 cli.py db upgrade）
DATABASE_URL=postgresql+psycopg://zak:zak@localhost:5432/zak

# JWT（Web 专用，勿与桌面端混淆）
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_EXPIRE_DAYS=7

# 可选：行情快照（与 zak 相同 Redis）
REDIS_URL=redis://127.0.0.1:6379/0

# 可选：Tushare（财务类 preset）
TUSHARE_TOKEN=

# 可选：B 站动态同步（Ops sync_bilibili_feed；浏览器 Cookie，含 SESSDATA 等）
BILIBILI_COOKIES=

# LLM（OpenAI 兼容）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# MCP（可选：Streamable HTTP；启用后白名单诊断工具注入 AI Agent）
MCP_ENABLED=false
MCP_URL=
MCP_API_KEY=
# 逗号分隔远端工具名；空则默认名称含 diagnose
MCP_TOOL_ALLOWLIST=

# CORS（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API 监听
API_HOST=127.0.0.1
API_PORT=8000

# 内嵌调度（覆盖全部可跑 job；与 BARS_SCHEDULER_ENABLED 同时为 true 才启动）
# 多 API 副本：同一 job 经 Redis 分布式锁防双跑（需 REDIS_URL）；Redis 不可用或抢锁失败则跳过该次定时
EMBEDDED_SCHEDULER_ENABLED=true
# 兼容旧开关；任一为 false 则关闭内嵌调度
BARS_SCHEDULER_ENABLED=true
# 盘中/盘后选股定时写入该用户的 screener_runs；空则跳过选股定时
SCHEDULER_SCREEN_USER_ID=
# 调度 job 锁 TTL（秒，夹逼 60–7200；默认 1800）
# SCHEDULER_LOCK_TTL_SECONDS=1800
# 情绪周期快照缓存 TTL（秒，夹逼 5–600；默认 60）
# EMOTION_CYCLE_CACHE_TTL_SEC=60

# 全市场日 K 首下统一起点（YYYY-MM-DD；默认 2020-01-01）
# BARS_UNIVERSE_START=2020-01-01
# 单次最多标的数 / 限流（与补全共用）
# BARS_FILL_MAX_SYMBOLS=500
# BARS_FILL_SLEEP_SEC=0.05

# —— Docker Compose（可选）——
# docker compose up --build 时，compose 会用下方覆盖 DATABASE/REDIS 指向宿主机：
# DOCKER_DATABASE_URL=postgresql+psycopg://zak:zak@host.docker.internal:5432/zak
# DOCKER_REDIS_URL=redis://host.docker.internal:6379/0
# DOCKER_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
